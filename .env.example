# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_DATABASE=7th_sense
DB_SSLMODE=disable

# Auth: send the session cookie over HTTPS only (set true in production)
COOKIE_SECURE=false

# Uploaded files (part drawings go in UPLOAD_DIR/part-drawings). Keep it outside the
# deploy directory in production so uploads survive deploys.
UPLOAD_DIR=uploads

# CNC Configuration
# CNC collection runs automatically on 32-bit builds; 64-bit builds skip it gracefully.
# Machines the server connects: ALL (or empty) = every active machine; 225,247 = only these
# (the others get no data, mode or status) — for analysing a few machines.
CNC_MACHINE_IDS=ALL
# CNC logs, all in logs/app.log (internal/monitor/cnc_log.go). true = write, false = skip;
# errors are always written. Restart the server to apply. Every line about a machine starts
# with "[machine <id> <name>]" and has logType, so app.log can be searched by machine or type.
#
# Machine events: connect, disconnect, alarm on/off, DLL errors, stale connection.
#   [machine 195 Poway] cnc machine event connect_ok  code=3 message="connection 3 (…)"
CNC_LOG_EVENTS=true
# Mode changes: the final mode first, the rule that decided it and only the values that rule
# checks. One line per change. Turn on to follow the machine modes.
#   [machine 195 Poway] cnc: mode In Production (from Hold)  reason="AUTO, program running,
#     feed override > 0, no alarm" opMode="2 (AUTO)" procStatus="2 (Active)" feedOverride=100 …
CNC_LOG_MODES=true
# Mode checks: the mode a reading decides, same format, whenever the rule or its values change
# (even when the mode stays the same). More lines; for comparing with the machine's HMI.
#   [machine 195 Poway] cnc: mode check Hold  current=Hold modeChanges=false
#     reason="program running, feed override ≤ 0" procStatus="2 (Active)" feedOverride=0
CNC_LOG_MODE_CHECKS=true
# Changed variable values, one line per reading that changed anything. Many lines; debugging only.
#   [machine 195 Poway] cnc: variable values changed  count=2 changes=["208:X_MachPos 12.5 -> 12.75", …]
CNC_LOG_VARIABLES=false
# Everything else: collector start/stop, connections, "controller data started/stopped",
# reading rate every 10 s per machine.
#   [machine 195 Poway] cnc: reading rate  seconds=10 callbacks=50 processed=50 skipped=0 storedValues=12
CNC_LOG_OTHER=true
# Raw DLL status fields (MachineMode, ProcStatus, AlarmNo, OpMsg, NC timer, …) whenever one
# changes. Analysis of what the DLL sends only.
#   [machine 195 Poway] cnc: snapshot status  MachineMode=1 machineModeName=AUTO ProcStatus=3 procStatusName=START …
CNC_LOG_SNAPSHOT=false
# Downtime check: machine type, alarm, E-stop, program status and downtime yes/no, whenever
# one changes. For finding why a machine is or is not Downtime.
#   [machine 195 Poway] cnc: downtime check downtime=false  machineType=Fanuc alarmNo=0 emergency=false …
CNC_LOG_DOWNTIME=true
#
# To watch only machine modes: CNC_LOG_MODES=true and the rest false (CNC_MACHINE_IDS narrows
# it to a few machines).