# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_DATABASE=7th_sense
DB_SSLMODE=disable

# Auth: send the session cookie over HTTPS only (set true in production)
COOKIE_SECURE=false

# Uploaded files (part drawings go in UPLOAD_DIR/part-drawings). Keep it outside the
# deploy directory in production so uploads survive deploys.
UPLOAD_DIR=uploads

# CNC Configuration
# Machines the server connects: ALL (or empty) = every active machine; 225,247 = only these
# (the others get no data, mode or status) — for analysing a few machines.
CNC_MACHINE_IDS=ALL
# CNC logs, all in logs/app.log (internal/monitor/cnc_log.go)
CNC_LOG_EVENTS=true
CNC_LOG_MODES=true
CNC_LOG_MODE_CHECKS=true
CNC_LOG_VARIABLES=false
CNC_LOG_OTHER=true