# Server
PORT=8080
# Serve Swagger UI and the OpenAPI spec at /api-docs/ (set false in production)
API_DOCS=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_DATABASE=7th_sense
DB_SSLMODE=disable

# Auth
# Send the session cookie over HTTPS only (set true in production)
COOKIE_SECURE=false

# Login sessions (server ADR 0014). Restart the server to apply a change.
# single   = one active session per user: a login while another is active answers 409
#            session_conflict; the user may log the other device out and continue.
# multiple = several sessions at once, at most MAX_SESSIONS (0 = unlimited); at the limit the
#            login answers the same 409 and "continue" logs out the least recently used one.
# "Log in as" sessions of the superadmin never count toward either limit.
SESSION_MODE=multiple
MAX_SESSIONS=0
# How often overdue sessions are marked expired (minutes), and how many days logged out,
# revoked and expired sessions are kept before they are deleted.
SESSION_CLEANUP_MINUTES=15
SESSION_RETENTION_DAYS=30
# Reverse proxies (IPs or CIDRs, comma separated) whose X-Forwarded-For header is believed for the
# client IP shown with each session. Empty = the connecting address is the client's.
TRUSTED_PROXIES=

# Uploaded files (part drawings go in UPLOAD_DIR/part-drawings). Keep it outside the
# deploy directory in production so uploads survive deploys.
UPLOAD_DIR=uploads

# CNC data collection (runs automatically on 32-bit builds; 64-bit builds skip it gracefully).
# Machines the server connects: ALL (or empty) = every active machine; 225,247 = only these
# (the others get no data, mode or status) — for analysing a few machines.
CNC_MACHINE_IDS=ALL

# CNC logs, all in logs/app.log (internal/monitor/cnc_log.go). true = write, false = skip;
# errors are always written. Restart the server to apply. Every line about a machine starts
# with "[machine <id> <name>]" and has logType, so app.log can be searched by machine or type.
# Machine events: connect, disconnect, alarm on/off, DLL errors, stale connection.
CNC_LOG_EVENTS=true
# Mode changes: the final mode first, the rule that decided it and only the values that rule
# checks. One line per change. Turn on to follow the machine modes.
CNC_LOG_MODES=true
# Mode checks: the mode a reading decides, same format, whenever the rule or its values change
# (even when the mode stays the same). More lines; for comparing with the machine's HMI.
CNC_LOG_MODE_CHECKS=true
# Changed variable values, one line per reading that changed anything. Many lines; debugging only.
CNC_LOG_VARIABLES=false
# Everything else: collector start/stop, connections, "controller data started/stopped",
# reading rate every 10 s per machine.
CNC_LOG_OTHER=true
# Raw DLL status fields (MachineMode, ProcStatus, AlarmNo, OpMsg, NC timer, …) whenever one
# changes. Analysis of what the DLL sends only.
CNC_LOG_SNAPSHOT=false
# Downtime check: machine type, alarm, E-stop, program status and downtime yes/no, whenever
# one changes. For finding why a machine is or is not Downtime.
CNC_LOG_DOWNTIME=true
# Machine cycles (internal/monitor/machine_cycle.go): each cycle opened, completed / unfinished
# (end reason, seconds per mode, parts) and restored after a restart. Rules and reasons:
# docs/machine-cycles.md. Errors saving a cycle are written even when this is false.
CNC_LOG_CYCLES=true
# A cycle open this many hours (whole hours, e.g. a machine left in Hold) is closed as
# unfinished with end reason timeout.
CNC_CYCLE_MAX_HOURS=24
#
# To watch only machine modes: CNC_LOG_MODES=true and the rest false (CNC_MACHINE_IDS narrows
# it to a few machines).

# Live data (Socket.IO at /api/v1/socket.io/, ADR 0009); false = screens poll REST
LIVE_ENABLED=true
# Shortest interval a screen may ask for: at most one message per room this often
LIVE_MIN_INTERVAL_MS=200
# How often every socket's session and machine access are checked again
LIVE_REVALIDATE_SEC=60
# Most open sockets (tabs, devices) of one user; the oldest is closed beyond it
LIVE_MAX_SOCKETS_PER_USER=10
